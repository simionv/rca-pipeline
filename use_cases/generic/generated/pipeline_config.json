{
  "modules": {
    "contact_reason": {
      "taxonomy_prefix": "CR",
      "taxonomy_file": "contact_reason.json",
      "taxonomy_key": "contact_reason",
      "reorder_group": "contact_reason",
      "reorder_order": 1,
      "description": "Identify the primary reason the customer contacted support. Assign the most specific leaf-level code that captures what the customer needed. If multiple reasons exist, capture the primary driver and log secondary reasons separately.",
      "classify_fn": "classify_contact_reason",
      "code_field": "contact_reason_primary_code",
      "discovery_mode": "",
      "extract_prompt": ""
    },
    "root_cause": {
      "taxonomy_prefix": "RC",
      "taxonomy_file": "root_cause.json",
      "taxonomy_key": "root_cause",
      "reorder_group": "root_cause",
      "reorder_order": 2,
      "description": "Identify the underlying root cause of the customer's issue. Distinguish between the symptom (what the customer reported) and the root cause (why it happened). Use the evidence field to cite specific transcript signals that support the classification.",
      "classify_fn": "classify_root_cause",
      "code_field": "root_cause_primary_code",
      "discovery_mode": "",
      "extract_prompt": ""
    },
    "customer_effort": {
      "taxonomy_prefix": "CE",
      "taxonomy_file": "customer_effort.json",
      "taxonomy_key": "customer_effort",
      "reorder_group": "customer_effort",
      "reorder_order": 3,
      "description": "Assess the level of effort the customer had to expend to resolve their issue. Consider the number of contacts, channels used, information required, and emotional burden. Higher effort indicates a worse customer experience.",
      "classify_fn": "classify_customer_effort",
      "code_field": "effort_primary_code",
      "discovery_mode": "",
      "extract_prompt": ""
    },
    "customer_sentiment": {
      "taxonomy_prefix": "",
      "taxonomy_file": "",
      "taxonomy_key": "",
      "reorder_group": "customer_sentiment",
      "reorder_order": 4,
      "description": "Classify the customer's emotional tone and sentiment trajectory throughout the interaction. Capture both the overall sentiment and how it evolved from start to end of the conversation. Identify specific emotional signals and what triggered any sentiment shifts.",
      "classify_fn": "classify_customer_sentiment",
      "code_field": null,
      "discovery_mode": "",
      "extract_prompt": ""
    },
    "agent_performance": {
      "taxonomy_prefix": "AP",
      "taxonomy_file": "agent_performance.json",
      "taxonomy_key": "agent_performance",
      "reorder_group": "agent_performance",
      "reorder_order": 5,
      "description": "Evaluate the agent's performance across key quality dimensions: communication, problem-solving, empathy, technical accuracy, and process adherence. Base the assessment strictly on evidence from the transcript, not assumptions.",
      "classify_fn": "classify_agent_performance",
      "code_field": "agent_performance_primary_code",
      "discovery_mode": "",
      "extract_prompt": ""
    },
    "communication_effectiveness": {
      "taxonomy_prefix": "",
      "taxonomy_file": "",
      "taxonomy_key": "",
      "reorder_group": "communication_effectiveness",
      "reorder_order": 6,
      "description": "Assess how clearly and effectively the agent communicated throughout the interaction. Evaluate clarity, tone, active listening, and completeness of responses. Identify any communication breakdowns that contributed to customer effort or dissatisfaction.",
      "classify_fn": "classify_communication_effectiveness",
      "code_field": null,
      "discovery_mode": "",
      "extract_prompt": ""
    },
    "voice_of_customer": {
      "taxonomy_prefix": "VOC",
      "taxonomy_file": "voice_of_customer.json",
      "taxonomy_key": "voice_of_customer",
      "reorder_group": "voice_of_customer",
      "reorder_order": 7,
      "description": "Extract explicit and implicit customer feedback, preferences, unmet needs, and loyalty signals from the transcript. Identify feature requests, competitor mentions, churn risk signals, and verbatim quotes that represent the customer's voice.",
      "classify_fn": "classify_voice_of_customer",
      "code_field": "voc_primary_code",
      "discovery_mode": "",
      "extract_prompt": ""
    },
    "escalation": {
      "taxonomy_prefix": "",
      "taxonomy_file": "",
      "taxonomy_key": "",
      "reorder_group": "escalation",
      "reorder_order": 8,
      "description": "Determine whether the interaction required or resulted in an escalation, and classify the reason and type. Flag cases where escalation was warranted but not executed, or where de-escalation was required. Capture the number of attempts before escalation.",
      "classify_fn": "classify_escalation",
      "code_field": null,
      "discovery_mode": "",
      "extract_prompt": ""
    },
    "resolution_quality": {
      "taxonomy_prefix": "",
      "taxonomy_file": "",
      "taxonomy_key": "",
      "reorder_group": "resolution_quality",
      "reorder_order": 9,
      "description": "Assess the quality and completeness of the resolution provided. Classify the resolution status, whether first-contact resolution was achieved, whether the customer acknowledged the resolution, and whether any follow-up actions were committed.",
      "classify_fn": "classify_resolution_quality",
      "code_field": null,
      "discovery_mode": "",
      "extract_prompt": ""
    },
    "resolution_actions": {
      "taxonomy_prefix": "RA",
      "taxonomy_file": "resolution_actions.json",
      "taxonomy_key": "resolution_actions",
      "reorder_group": "resolution_actions",
      "reorder_order": 10,
      "description": "Classify the specific action(s) the agent took to resolve the customer's issue. This captures WHAT was done (refund issued, workaround provided, ticket raised) rather than HOW WELL it was done - that is assessed by the resolution_quality module. Assign the most significant action as primary; list secondary actions separately.",
      "classify_fn": "classify_resolution_actions",
      "code_field": "resolution_action_primary_code",
      "discovery_mode": "",
      "extract_prompt": ""
    },
    "follow_up": {
      "taxonomy_prefix": "FU",
      "taxonomy_file": "follow_up.json",
      "taxonomy_key": "follow_up",
      "reorder_group": "follow_up",
      "reorder_order": 11,
      "description": "Classify any follow-up actions explicitly committed during the interaction. A follow-up is any action that must occur after the conversation ends to fully close the customer's issue. Identify who owns the action, what it is, and whether a deadline was committed.",
      "classify_fn": "classify_follow_up",
      "code_field": "follow_up_primary_code",
      "discovery_mode": "",
      "extract_prompt": ""
    },
    "compliance_and_risk": {
      "taxonomy_prefix": "RISK",
      "taxonomy_file": "compliance_and_risk.json",
      "taxonomy_key": "compliance_and_risk",
      "reorder_group": "compliance_and_risk",
      "reorder_order": 12,
      "description": "Identify compliance, legal, safety, fraud, or reputational risk signals present in the transcript. Flag any signal that warrants escalation to a compliance, legal, or safeguarding team. Assign 'No risk identified' if no signals are present - do not leave this field blank.",
      "classify_fn": "classify_compliance_and_risk",
      "code_field": "risk_primary_code",
      "discovery_mode": "",
      "extract_prompt": ""
    },
    "insights_and_opportunities": {
      "taxonomy_prefix": "",
      "taxonomy_file": "",
      "taxonomy_key": "",
      "reorder_group": "insights_and_opportunities",
      "reorder_order": 13,
      "description": "Extract actionable strategic insights and commercial opportunities from the transcript. Identify whether the interaction reveals a product gap, process gap, training need, knowledge article opportunity, or commercial opportunity (upsell, churn prevention). Focus on signals that are actionable for product, CX, or operations teams.",
      "classify_fn": "classify_insights_and_opportunities",
      "code_field": null,
      "discovery_mode": "",
      "extract_prompt": ""
    },
    "customer_profile": {
      "taxonomy_prefix": "",
      "taxonomy_file": "",
      "taxonomy_key": "",
      "reorder_group": "customer_profile",
      "reorder_order": 14,
      "description": "Infer customer profile characteristics from signals in the transcript. These are inferences - not data lookups - based on vocabulary, questions asked, context, and expressed needs. Flag uncertainty with 'unknown' rather than guessing.",
      "classify_fn": "classify_customer_profile",
      "code_field": null,
      "discovery_mode": "",
      "extract_prompt": ""
    },
    "knowledge_management": {
      "taxonomy_prefix": "KM",
      "taxonomy_file": "knowledge_management.json",
      "taxonomy_key": "knowledge_management",
      "reorder_group": "knowledge_management",
      "reorder_order": 15,
      "description": "Identify whether this interaction reveals a gap in the company's documentation, knowledge base, or FAQ - and what type of knowledge asset would close that gap. Also flag internal knowledge or training gaps observed in the agent's responses. Assign 'No knowledge gap' if existing resources are adequate.",
      "classify_fn": "classify_knowledge_management",
      "code_field": "knowledge_gap_primary_code",
      "discovery_mode": "",
      "extract_prompt": ""
    },
    "interaction_classification": {
      "taxonomy_prefix": "",
      "taxonomy_file": "",
      "taxonomy_key": "",
      "reorder_group": "interaction_classification",
      "reorder_order": 16,
      "description": "Classify the structural characteristics of the interaction itself - independent of the issue content. Captures what TYPE of interaction this is, how complex it was, whether multiple issues were raised, and what channel it appears to have come through. This module provides the structural frame used for routing, workforce management, and segmentation analytics across all other modules.",
      "classify_fn": "classify_interaction_classification",
      "code_field": null,
      "discovery_mode": "",
      "extract_prompt": ""
    },
    "containment_and_deflection": {
      "taxonomy_prefix": "",
      "taxonomy_file": "",
      "taxonomy_key": "",
      "reorder_group": "containment_and_deflection",
      "reorder_order": 17,
      "description": "Assess whether this contact could have been handled without a human agent - through self-service, automation, or proactive outreach - and identify what prevented deflection. Also flag whether this contact could have been avoided entirely. This module drives containment rate KPIs and automation ROI decisions.",
      "classify_fn": "classify_containment_and_deflection",
      "code_field": null,
      "discovery_mode": "",
      "extract_prompt": ""
    },
    "customer_journey": {
      "taxonomy_prefix": "",
      "taxonomy_file": "",
      "taxonomy_key": "",
      "reorder_group": "customer_journey",
      "reorder_order": 18,
      "description": "Map the customer's position and history within their support journey for this issue. Captures where this contact sits in a sequence (first contact vs third attempt), where the customer is in their product lifecycle, how long they have had the problem, and - critically - what self-service channels they already tried before contacting support. This module consolidates journey signals scattered across other modules and adds two signals not captured elsewhere: pre-contact self-service attempts and time-with-issue.",
      "classify_fn": "classify_customer_journey",
      "code_field": null,
      "discovery_mode": "",
      "extract_prompt": ""
    },
    "customer_intent": {
      "taxonomy_prefix": "INT",
      "taxonomy_file": "customer_intent.json",
      "taxonomy_key": "customer_intent",
      "reorder_group": "customer_intent",
      "reorder_order": 19,
      "description": "What action the customer wants taken — distinct from contact_reason (the situation) and interaction_classification (the contact type). Intent is action-oriented: cancel, refund, restore access, update details, get information, report a problem, dispute a decision. Captures primary and secondary intents, whether intent shifted mid-contact, and whether the intent was self-serviceable. Primary input for chatbot/IVR routing and deflection strategy.",
      "classify_fn": "classify_customer_intent",
      "code_field": "primary_intent_code",
      "discovery_mode": "",
      "extract_prompt": ""
    }
  },
