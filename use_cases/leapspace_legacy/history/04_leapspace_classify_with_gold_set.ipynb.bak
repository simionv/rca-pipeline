    "    print(\"Contact Reason distribution in output:\")\n",
    "    print(results[cr_col[0]].value_counts().to_string())\n",
    "    print()\n",
    "\n",
    "if rc_col:\n",
    "    print(\"Root Cause distribution in output:\")\n",
