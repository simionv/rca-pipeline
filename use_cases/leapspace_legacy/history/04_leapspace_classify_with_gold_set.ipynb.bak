   "source": [
    "# Identify the generated label columns (adjust names if your taxonomy uses codes)\n",
    "cr_col = [c for c in results.columns if \"contact_reason\" in c.lower() and \"label\" in c.lower()]\n",
    "rc_col = [c for c in results.columns if \"root_cause\" in c.lower() and \"label\" in c.lower()]\n",
    "\n",
    "print(\"Contact Reason columns found:\", cr_col)\n",
    "print(\"Root Cause columns found:\", rc_col)"
   ]
  },
  {
   "cell_type": "code",
