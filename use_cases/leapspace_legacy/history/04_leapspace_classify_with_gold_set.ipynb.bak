{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# LeapSpace Classification with Gold-Set Few-Shot Examples\n",
    "\n",
    "This notebook:\n",
    "1. Converts the 69-ticket gold set into FeedbackStore JSONL files\n",
    "2. Runs `run_pipeline.py` on `leapspace_collapsed.csv` with those examples injected as few-shot prompts\n",
    "3. Optionally evaluates pipeline accuracy against the gold set itself\n",
    "\n",
    "**How it works:** The gold set tickets are loaded into the FeedbackStore as pre-seeded \"corrections\". The pipeline's `--feedback-strategy smart` then selects the most relevant examples per batch and injects them into each LLM prompt, anchoring classification to your labelled examples.\n",
    "\n",
    "No ID matching is needed — the examples are used as prompt context, not joined as rows."
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 0. Configuration — edit this cell"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "c113407e",
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "os.chdir(r\"c:\\Users\\simionv\\custom_taxonomy_v1\")\n",
    "\n",
    "from pathlib import Path\n",
    "BASE = Path().resolve()\n",
    "\n",
    "\n",
    "# ── Paths ──────────────────────────────────────────────────────────────────\n",
    "PROJECT_DIR    = BASE\n",
    "GOLD_SET_PATH  = BASE / \"data/leapspace_gold_set.xlsx\"\n",
    "INPUT_CSV      = BASE / \"data/leapspace_collapsed.csv\"\n",
    "OUTPUT_PATH    = BASE / \"runs/output/leapspace_enriched.xlsx\"\n",
    "FEEDBACK_DIR   = BASE / \"feedback/leapspace\"\n",
    "EVAL_GOLD_TEST = BASE / \"data/leapspace_gold_test.csv\"  # written by cell 5 in split mode\n",
    "\n",
    "# ── Mode ────────────────────────────────────────────────────────────────────\n",
    "# \"all\"   : all 69 gold tickets as few-shot → best accuracy; post-run eval\n",
    "#            is in-sample only (use k-fold in cell 23 for honest numbers)\n",
    "# \"split\" : 49 few-shot / 20 held-out → honest benchmark; eval runs after\n",
    "#            the main classification (cell 13)\n",
    "# k-fold  : always available in cell 23, independent of this setting\n",
    "EVAL_MODE = \"all\"   # <-- change to \"all\" to use every gold ticket for few-shot\n",
    "\n",
    "# ── Classification settings ──────────────────────────────────────────────\n",
    "TEXT_COL          = \"Conversation\"\n",
    "MODULES           = [\"contact_reason\"]\n",
    "FEEDBACK_STRATEGY = \"smart\"\n",
    "FEEDBACK_MAX      = 5\n",
    "BATCH_SIZE        = 10\n",
    "CONCURRENCY       = 4\n",
    "\n",
    "# ── Sanity check ────────────────────────────────────────────────────────\n",
    "assert GOLD_SET_PATH.exists(), f\"Gold set not found: {GOLD_SET_PATH}\"\n",
    "assert INPUT_CSV.exists(), f\"Input CSV not found: {INPUT_CSV}\"\n",
    "print(f\"Paths OK  |  mode: {EVAL_MODE}\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "281ba308",
   "metadata": {},
   "source": [
    "## 1. Load gold set and inspect labels"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "9fd52458",
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "\n",
    "gold = pd.read_excel(GOLD_SET_PATH)\n",
    "print(f\"Gold set: {len(gold)} tickets\")\n",
    "print(f\"Columns: {gold.columns.tolist()}\")\n",
    "print()\n",
    "print(\"Contact Reason distribution:\")\n",
    "print(gold[\"Contact Reason\"].value_counts().to_string())\n",
    "print()\n",
    "print(\"Root Cause distribution:\")\n",
    "print(gold[\"Root Cause\"].value_counts().to_string())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "28300c8f",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Load hierarchy code map and apply EVAL_MODE ──────────────────────────────\n",
    "import json\n",
    "\n",
    "CODE_MAP_PATH = BASE / \"data/leapspace_code_map.json\"\n",
    "assert CODE_MAP_PATH.exists(), (\n",
    "    \"Code map not found. Run: python scripts/build_leapspace_definition.py\"\n",
    ")\n",
    "with open(CODE_MAP_PATH, encoding=\"utf-8\") as _f:\n",
    "    _code_map = json.load(_f)\n",
    "# hierarchy[cr_label][rc_label] -> leaf code  (e.g. \"CR4.2\")\n",
    "hierarchy = _code_map[\"hierarchy\"]\n",
    "print(f\"Code map: {sum(len(v) for v in hierarchy.values())} CR->RC leaf codes\")\n",
    "print()\n",
    "\n",
    "if EVAL_MODE == \"all\":\n",
    "    gold_train = gold.copy()\n",
    "    print(f\"Mode ALL: {len(gold_train)} tickets used as few-shot examples\")\n",
    "    print(\"  Post-run eval (cell 13) will be in-sample.\")\n",
    "    print(\"  For an honest estimate run k-fold (cell 23).\")\n",
    "\n",
    "elif EVAL_MODE == \"split\":\n",
    "    from sklearn.model_selection import train_test_split\n",
    "    _cr_counts = gold[\"Contact Reason\"].value_counts()\n",
    "    _stratify  = gold[\"Contact Reason\"].where(\n",
    "        gold[\"Contact Reason\"].map(_cr_counts) >= 2, \"other\"\n",
    "    )\n",
    "    gold_train, gold_test = train_test_split(\n",
    "        gold, test_size=20, random_state=42, stratify=_stratify\n",
    "    )\n",
    "    gold_test.to_csv(EVAL_GOLD_TEST, index=False)\n",
    "    print(f\"Mode SPLIT: {len(gold_train)} few-shot | {len(gold_test)} held-out\")\n",
    "    print(f\"  Test set: {EVAL_GOLD_TEST.relative_to(BASE)}\")\n",
    "\n",
    "else:\n",
    "    raise ValueError(f\"Unknown EVAL_MODE: {EVAL_MODE!r}. Use 'all' or 'split'.\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "5c702c44",
   "metadata": {},
   "source": [
    "## 2. Write gold set to FeedbackStore JSONL\n",
    "\n",
    "Each ticket becomes a feedback entry where `original == corrected` (i.e. the human label is treated as an authoritative correction). The `reason` field is populated from the `Explanations` column — this is the highest-weighted signal in the `smart` strategy."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "518e7b66",
   "metadata": {},
   "outputs": [],
   "source": [
    "import json\n",
    "from datetime import datetime, timezone\n",
    "\n",
    "FEEDBACK_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "def write_feedback_jsonl(df, out_path):\n",
    "    \"\"\"Write gold-set rows as FeedbackStore JSONL using hierarchical CR->RC codes.\"\"\"\n",
    "    entries, skipped = [], 0\n",
    "    for _, row in df.iterrows():\n",
    "        cr   = str(row[\"Contact Reason\"]).strip()\n",
    "        rc   = str(row[\"Root Cause\"]).strip()\n",
    "        code = hierarchy.get(cr, {}).get(rc)\n",
    "        if not code:\n",
    "            skipped += 1\n",
    "            continue\n",
    "        entries.append({\n",
    "            \"uid\":       str(row[\"Ticket Number\"]),\n",
    "            \"text\":      str(row[\"Conversation\"])[:1500],\n",
    "            \"original\":  {\"contact_reason_primary_code\": code},\n",
    "            \"corrected\": {\"contact_reason_primary_code\": code},\n",
    "            \"reason\":    str(row.get(\"Explanations\", \"\")).strip(),\n",
    "            \"timestamp\": datetime.now(timezone.utc).isoformat(),\n",
    "            \"module\":    \"contact_reason\",\n",
    "        })\n",
    "    with open(out_path, \"w\", encoding=\"utf-8\") as f:\n",
    "        for e in entries:\n",
    "            f.write(json.dumps(e, ensure_ascii=False) + \"\\n\")\n",
    "    print(f\"  {out_path.name}: {len(entries)} entries ({skipped} skipped)\")\n",
    "    return entries\n",
    "\n",
    "cr_entries = write_feedback_jsonl(\n",
    "    gold_train,\n",
    "    FEEDBACK_DIR / \"contact_reason_corrections.jsonl\",\n",
    ")\n",
    "\n",
    "# Remove stale root_cause JSONL if it exists from the old two-module setup\n",
    "_old_rc = FEEDBACK_DIR / \"root_cause_corrections.jsonl\"\n",
    "if _old_rc.exists():\n",
    "    _old_rc.unlink()\n",
    "    print(f\"  Removed stale: {_old_rc.name}\")\n",
    "\n",
    "print(\"\\nFeedback JSONL ready.\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "33b99983",
   "metadata": {},
   "source": [
    "### 2a. Sanity check: verify a few entries"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "1e459523",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Sanity check: verify a sample feedback entry\n",
    "print(\"Sample entry (hierarchical: L1=Contact Reason, L2=Root Cause):\")\n",
    "print(json.dumps(cr_entries[0], indent=2, ensure_ascii=False))\n",
    "print()\n",
    "# Decode the code back to CR / RC labels for readability\n",
    "sample_code = cr_entries[0][\"corrected\"][\"contact_reason_primary_code\"]\n",
    "# Find which CR->RC pair this code belongs to\n",
    "for cr, rc_map in hierarchy.items():\n",
    "    for rc, code in rc_map.items():\n",
    "        if code == sample_code:\n",
    "            print(f\"  {sample_code}  =>  Contact Reason: '{cr}'  /  Root Cause: '{rc}'\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "dc4deaf6",
   "metadata": {},
   "source": [
    "## 3. Preview the full dataset"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "fa734ce7",
   "metadata": {},
   "outputs": [],
   "source": [
    "full_df = pd.read_csv(INPUT_CSV)\n",
    "print(f\"Full dataset: {len(full_df)} rows\")\n",
    "print(f\"Columns: {full_df.columns.tolist()}\")\n",
    "print()\n",
    "full_df.head(3)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "9bee5c8c",
   "metadata": {},
   "source": [
    "## 4. Run the pipeline\n",
    "\n",
    "This calls `run_pipeline.py` with:\n",
    "- `--feedback-dir` pointing to the JSONL files we just wrote\n",
    "- `--feedback-strategy smart` (adapts example selection per batch based on token-overlap with the batch content)\n",
    "- `--modules contact_reason root_cause` (skip unrelated modules)\n",
    "\n",
    "Estimated time: ~1–2 min per 100 tickets at default concurrency."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "b31f71f6",
   "metadata": {},
   "outputs": [],
   "source": [
    "import subprocess, sys, threading\n",
    "\n",
    "OUTPUT_PATH.parent.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "cmd = [\n",
    "    sys.executable, str(PROJECT_DIR / \"run_pipeline.py\"),\n",
    "    \"--input\",                str(INPUT_CSV),\n",
    "    \"--output\",               str(OUTPUT_PATH),\n",
    "    \"--text-col\",             TEXT_COL,\n",
    "    \"--modules\",              \"contact_reason\",\n",
    "    \"--feedback-dir\",         str(FEEDBACK_DIR),\n",
    "    \"--feedback-strategy\",    FEEDBACK_STRATEGY,\n",
    "    \"--feedback-max-examples\", str(FEEDBACK_MAX),\n",
    "    \"--batch-size\",           str(BATCH_SIZE),\n",
    "    \"--concurrency\",          str(CONCURRENCY),\n",
    "    \"--track-costs\",\n",
    "    \"--taxonomy-dir\",       str(BASE / \"data/leapspace_taxonomies\"),\n",
    "]\n",
    "\n",
    "if EVAL_MODE == \"split\" and EVAL_GOLD_TEST.exists():\n",
    "    cmd += [\"--eval-gold-test\", str(EVAL_GOLD_TEST)]\n",
    "elif EVAL_MODE == \"all\":\n",
    "    print(\"Mode ALL: skipping post-run eval. Run k-fold (cell 23) for honest numbers.\")\n",
    "    print()\n",
    "\n",
    "print(\"Running:\", \" \".join(str(c) for c in cmd))\n",
    "print()\n",
    "\n",
    "_err_lines: list[str] = []\n",
    "\n",
    "def _capture_err(proc):\n",
    "    for line in iter(proc.stderr.readline, \"\"):\n",
    "        _err_lines.append(line)\n",
    "\n",
    "proc = subprocess.Popen(\n",
    "    cmd, text=True, encoding=\"utf-8\", errors=\"replace\",\n",
    "    stdout=subprocess.PIPE, stderr=subprocess.PIPE, bufsize=1,\n",
    ")\n",
    "_t = threading.Thread(target=_capture_err, args=(proc,), daemon=True)\n",
    "_t.start()\n",
    "for _line in iter(proc.stdout.readline, \"\"):\n",
    "    print(_line, end=\"\", flush=True)\n",
    "proc.wait()\n",
    "_t.join(timeout=5)\n",
    "\n",
    "if proc.returncode == 0:\n",
    "    print(f\"\\n-> Pipeline complete. Output: {OUTPUT_PATH}\")\n",
    "else:\n",
    "    print(f\"\\n-> Pipeline exited with code {proc.returncode}\")\n",
    "    if _err_lines:\n",
    "        print(\"\\n--- Errors (last 60 lines) ---\")\n",
    "        print(\"\".join(_err_lines[-60:]))\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cb8039f1",
   "metadata": {},
   "source": [
    "## 5. Inspect results"
   ]
  },
  {
