# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Azure OpenAI (used when LLM_BACKEND=litellm and RCA_MODEL starts with azure/)
AZURE_API_KEY=
AZURE_API_BASE=
AZURE_API_VERSION=2024-02-01

# OpenAI (used when USE_AZURE=false)
OPENAI_API_KEY=

# ── LLM Backend ──────────────────────────────────────────────────────────────
# "litellm"  — default, routes to Azure/OpenAI/Anthropic via LiteLLM
# "openai"   — use OpenAI SDK directly (Azure compatible)
LLM_BACKEND=litellm

# ── Model & Sampling ─────────────────────────────────────────────────────────
RCA_MODEL=azure/dsaic-llm-general
RCA_TEMPERATURE=0.0
RCA_MAX_TOKENS=4096
RCA_TIMEOUT=120

# ── Batching & Concurrency ───────────────────────────────────────────────────
RCA_BATCH_SIZE=10
RCA_MAX_CHARS=60000
RCA_CONCURRENCY=2
RCA_RETRIES=5

# ── Async Worker Tuning ──────────────────────────────────────────────────────
MAX_WORKERS=4
MAX_IN_FLIGHT=8
CHECKPOINT_EVERY=5

# ── Logging ──────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── OSvC export client (tools/osvc_api) ──────────────────────────────────────
OSVC_USERNAME=
OSVC_PASSWORD=
